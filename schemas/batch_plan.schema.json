{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dbtl/batch_plan",
  "title": "Batch plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["round", "picks"],
  "properties": {
    "round": {"type": "integer", "minimum": 1},
    "picks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "serves", "role", "predicted", "interval", "why_this_one", "predictions_by_hypothesis"],
        "properties": {
          "candidate": {"type": "string", "minLength": 1},
          "serves": {"type": ["string", "null"]},
          "role": {"type": "string", "enum": ["exploit", "discriminate", "explore"]},
          "predicted": {"type": "number"},
          "interval": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
          "why_this_one": {"type": "string"},
          "predictions_by_hypothesis": {
            "type": "object",
            "additionalProperties": {"type": "number"}
          }
        }
      }
    }
  }
}
